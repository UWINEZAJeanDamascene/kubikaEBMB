{
  "name": "stock-management-backend",
  "version": "1.0.0",
  "description": "Stock Management System Backend for Quantity Survey",
  "main": "server.js",
  "scripts": {
    "start": "npm run db:migrate:deploy && concurrently --kill-others --success first --names server,worker --prefix-colors cyan,magenta \"node server.js\" \"node worker.js\"",
    "dev": "concurrently --kill-others --success first --names server,worker --prefix-colors cyan,magenta \"nodemon server.js\" \"nodemon worker.js\"",
    "worker": "node worker.js",
    "worker:dev": "nodemon worker.js",
    "migrate:backfill-account-balances": "node scripts/backfill_account_balances.js --dry-run",
    "drop-category-unique-index": "node scripts/removeCategoryUniqueIndex.js",
    "test": "jest --runInBand --passWithNoTests",
    "test:ebm": "jest --runInBand test/vsdcPayloadSanitizer.test.js test/ebmService.endpoints.test.js test/ebmVsdcSpecCompliance.test.js test/ebmSyncTypes.test.js test/ebmOperationPrerequisites.test.js test/ebmPurchaseRetrieval.test.js test/ebmSalesService.payload.test.js test/ebmStockService.payload.test.js test/ebmStockContractGate.test.js test/ebmImportedItemService.payload.test.js test/ebmCustomerTinService.test.js test/ebmPurchaseService.payload.test.js test/ebmProductService.payload.test.js test/ebmBranchService.payload.test.js test/ebmStockTypeCodes.test.js test/ebmStockSequenceStep11.test.js test/ebmStockReconciliationController.test.js test/ebmLookupPermissions.test.js",
    "test:ebm:mock": "node scripts/ebm-e2e-runner.js",
    "migrate:journal": "node scripts/migrate_journal_engine.js",
    "migrate:bank-transactions": "node scripts/backfillBankTransactionsFromJournalEntries.js",
    "seed:platform-admin": "node scripts/seedPlatformAdmin.js",
    "delivery-notes:backfill": "node scripts/backfillDeliveryNotes.js",
    "repair:pos-opening-stock-levels": "node scripts/backfill-pos-opening-stock-levels.js",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:studio": "prisma studio",
    "test:phase1": "jest --runInBand test/phase1PrismaHelpers.test.js",
    "test:phase2": "jest --runInBand test/phase2MasterData.test.js",
    "test:phase3-4": "jest --runInBand test/phase3-4InventoryJournal.test.js",
    "test:phase5-6": "jest --runInBand test/phase5-6SalesAp.test.js",
    "test:phase7-9": "jest --runInBand test/phase7-9BankingReports.test.js",
    "tax:backfill": "node scripts/backfill-tax-transactions-from-journals.js",
    "tax:backfill:dry": "node scripts/backfill-tax-transactions-from-journals.js --dry-run",
    "tax:reconcile": "node scripts/reconcile-tax-transactions.js",
    "test:tax-transactions": "jest --runInBand test/taxTransaction.test.js",
    "test:phase10": "jest --runInBand test/phase10BudgetPayrollAssetsEbm.test.js",
    "test:phase0-step8": "jest --runInBand test/phase0TransactionsSequences.test.js",
    "test:atomicity": "jest --runInBand test/transactionAtomicity.test.js",
    "test:pos-e2e": "jest --runInBand --forceExit test/posCheckoutPathRetired.test.js test/posE2eCheckout.test.js test/posE2eTillApprovals.test.js test/salesLegacyPosSerials.test.js",
    "test:agg-parity": "jest --runInBand test/journalAggregationParity.test.js test/prismaAggregateFilters.test.js",
    "test:ai": "npm run ai:check-boundaries && jest --runInBand ai-engine test/aiActionProposalService.test.js test/aiPhase14Observability.test.js test/aiFindingService.test.js test/aiForecastService.test.js test/aiMonitoringService.test.js",
    "test:ai:adversarial": "jest --runInBand ai-engine/tests/adversarial",
    "ai:check-boundaries": "node scripts/check-ai-boundaries.js",
    "perf:baseline": "node scripts/capture-baseline.js",
    "perf:warm-top10": "node scripts/warm-top-endpoints.js",
    "perf:baseline:top10": "node scripts/warm-top-endpoints.js && node scripts/capture-baseline.js --top10",
    "query:safety": "node scripts/check-query-safety.js",
    "perf:readiness": "node scripts/check-performance-readiness.js"
  },
  "keywords": [
    "stock",
    "inventory",
    "management",
    "quantity-survey"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.73.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-devtools": "^5.99.0",
    "@upstash/redis": "^1.36.3",
    "archiver": "^7.0.1",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.70.4",
    "bwip-js": "^2.0.11",
    "compression": "^1.8.1",
    "concurrently": "^10.0.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.6.0",
    "dotenv": "^16.6.1",
    "dropbox": "^10.34.0",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "googleapis": "^121.0.0",
    "googledrive": "^3.2.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "mailgun-js": "^0.22.0",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.2",
    "openai": "4.82.0",
    "pdfkit": "^0.13.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "redis": "^6.1.0",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^29.6.1",
    "mongodb-memory-server": "^8.12.1",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/test/jest.setup.js"
    ],
    "testTimeout": 20000
  }
}
