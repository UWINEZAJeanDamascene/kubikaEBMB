PORT=3000
NODE_ENV=development

# Add other keys here as placeholders, do NOT commit real secrets.
EXAMPLE_API_KEY=your_api_key_here
# =============================================================================
# Environment Configuration Template
# =============================================================================
# Copy this file to .env.development, .env.staging, or .env.production
# and fill in the values for your environment.
# NEVER commit .env.development, .env.staging, or .env.production to git!
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Node environment: development, staging, production, test
NODE_ENV=development

# Server port
PORT=3000

# Frontend URL (for CORS and email links)
# Example: http://localhost:5173 (development), https://staging.yourdomain.com, https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# Allowed origins for CORS (comma-separated)
# Example: http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB connection URI
# Local: mongodb://localhost:27017/stock-management
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# PostgreSQL (Prisma) — REQUIRED. Auth/tenancy (users, companies, roles) runs on Postgres.
# Local docker-compose: postgresql://stock:stock@localhost:5432/stock_management?schema=public
# Hosted (e.g. Neon): use the pooled endpoint here and the direct endpoint in DIRECT_URL.
DATABASE_URL=postgresql://stock:stock@localhost:5432/stock_management?schema=public
# Direct (non-pooled) connection used by prisma migrate. Same as DATABASE_URL when no pooler.
DIRECT_URL=postgresql://stock:stock@localhost:5432/stock_management?schema=public

# Prisma log levels (comma-separated): query,info,warn,error
# PRISMA_LOG=warn

# MongoDB connection pool settings (optional)
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
# MONGODB_SOCKET_TIMEOUT_MS=0
# MONGODB_CONNECT_TIMEOUT_MS=30000
# MONGODB_HEARTBEAT_FREQUENCY_MS=10000

# =============================================================================
# JWT & AUTHENTICATION
# =============================================================================

# JWT secret key - MUST be changed in production!
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT token expiration
# Development: 60m (easier for testing)
# Staging/Production: 15m
JWT_EXPIRE=60m

# JWT refresh token expiration
JWT_REFRESH_EXPIRE=7d

# JWT issuer (optional)
# JWT_ISSUER=stock-management

# JWT audience (optional)
# JWT_AUDIENCE=stock-management-app

# =============================================================================
# PLATFORM ADMIN (one-time web setup)
# =============================================================================
# Set a long, unique value before deploying. On an empty database, the login
# page shows a one-time "Set up platform control room" entry. It can create
# exactly one platform administrator and then becomes unavailable.
PLATFORM_ADMIN_SETUP_KEY=replace-with-a-long-random-secret
# The optional seed script remains available for non-web deployments, but it
# requires explicit PLATFORM_ADMIN_EMAIL and PLATFORM_ADMIN_PASSWORD values.

# =============================================================================
# SESSION MANAGEMENT
# =============================================================================

# Session TTL in seconds (default: 86400 = 24 hours)
SESSION_TTL=86400

# Maximum concurrent sessions per user (FIFO eviction)
# Set to 0 for unlimited
SESSION_MAX_CONCURRENT=5

# =============================================================================
# SECURITY
# =============================================================================

# Bcrypt rounds for password hashing (higher = more secure but slower)
# Recommended: 10-12 for production
BCRYPT_ROUNDS=12

# Rate limiting window in milliseconds (default: 15 minutes)
# RATE_LIMIT_WINDOW_MS=900000

# Rate limiting max requests per window
# RATE_LIMIT_MAX_REQUESTS=100

# Low stock threshold for notifications
LOW_STOCK_THRESHOLD=10

# =============================================================================
# REDIS CONFIGURATION (Caching & Sessions)
# =============================================================================

# Option 1: Upstash Serverless Redis (recommended for serverless/production)
# UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Option 2: Redis URL (Render, Redis Cloud, etc.)
# REDIS_URL=redis://username:password@host:port
#
# Phase 0 — staging/production require Redis + Sentry by default (see utils/performancePhase0.js).
# Set to false only for local experiments against staging-like NODE_ENV.
# PERFORMANCE_REQUIRE_REDIS=false
# PERFORMANCE_REQUIRE_SENTRY=false
# Explicit pool sizing must be tuned per deployed database/pooler.
# PRISMA_CONNECTION_LIMIT=20

# Option 3: Redis Cluster
# REDIS_CLUSTER_NODES=host1:6379,host2:6379,host3:6379

# Option 4: Standalone Redis (local/development)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-password
# REDIS_DB=0

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# Email provider: gmail, resend, or smtp
EMAIL_PROVIDER=gmail

# Gmail configuration
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password

# Resend configuration (uncomment and set EMAIL_PROVIDER=resend to use)
# RESEND_API_KEY=re_your_resend_api_key

# SMTP configuration (fallback)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password

# Email sender info
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
# EMAIL_FROM_NAME=KUBIKA SYSTEM

# =============================================================================
# SMS CONFIGURATION (Optional)
# =============================================================================

# Twilio configuration
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+1234567890

# Nexmo/Vonage configuration (alternative)
# NEXMO_API_KEY=your-nexmo-api-key
# NEXMO_API_SECRET=your-nexmo-api-secret
# NEXMO_FROM_NUMBER=StockMgmt

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================

# Payment reminder days before due date
PAYMENT_REMINDER_DAYS=3

# Enable daily summary emails (true/false)
DAILY_SUMMARY_ENABLED=false

# Enable weekly summary emails (true/false)
WEEKLY_SUMMARY_ENABLED=true

# Large order threshold for notifications
LARGE_ORDER_THRESHOLD=10000

# =============================================================================
# CLOUD STORAGE (Optional)
# =============================================================================

# Dropbox configuration
# DROPBOX_ACCESS_TOKEN=your-dropbox-token

# Google Drive configuration
# GOOGLE_DRIVE_FOLDER_ID=your-folder-id
# GOOGLE_SERVICE_ACCOUNT_FILE=./config/google-credentials.json
# GOOGLE_DRIVE_OWNER_EMAIL=your-email@gmail.com

# =============================================================================
# AI/CHATBOT CONFIGURATION (Optional)
# =============================================================================
#
# Stacy AI can use a multi-provider fallback chain:
#   1. Groq (fast hosted LLM) - recommended primary
#   2. Mistral/OpenRouter/DeepSeek/Together
#   3. Google Gemini fallback
#
# If one fails or hits quota, the next is tried automatically.
# Override fallback order with a comma-separated list if needed:
# AI_PROVIDER_ORDER=groq,gemini,mistral,openrouter,deepseek,together,ollama
# Ollama is available only outside production:
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
#
# Response caching reduces API calls. Default TTL is 30 seconds.
#
# PRODUCTION PRIVACY REVIEW REQUIRED:
# Before enabling any hosted AI provider for real tenant data, review that
# provider's current data-use, retention, and training policies. Terms can
# change. Mask sensitive fields before sending prompts, and do not enable a
# provider in production until the residual privacy risk is explicitly accepted.
#
# =============================================================================

# --- Primary: Groq (fastest, recommended) ---
# Get your key at: https://console.groq.com/keys
# GROQ_API_KEY=your-groq-api-key
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-20b

# --- Fallback 1: Mistral AI (1B free tokens/month) ---
# Get your key at: https://console.mistral.ai
# MISTRAL_API_KEY=your-mistral-api-key
# MISTRAL_MODEL=mistral-small-latest

# --- Fallback 2: OpenRouter (100+ models, one key) ---
# Get your key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=openrouter/free

# --- Fallback 3: DeepSeek (free tier, reasoning model) ---
# Get your key at: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_MODEL=deepseek-chat

# --- Fallback 4: Together AI (free tier, open-source models) ---
# Get your key at: https://www.together.ai/
# TOGETHER_API_KEY=your-together-api-key
# TOGETHER_MODEL=meta-llama/Llama-3.2-3B-Instruct-Turbo

# --- Fallback 5: Google Gemini ---
# Get your key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Caching & performance tuning ---
# AI_CACHE_TTL_SECONDS=30
  # AI_TIMEOUT_MS=10000
  # AI_METRICS_RETENTION_DAYS=90

  # AI feature switches (all enabled by default outside production rollout controls)
  # AI_FEATURE_CHAT_V2_ENABLED=true
  # AI_FEATURE_FINDINGS_ENABLED=true
  # AI_FEATURE_PROPOSALS_ENABLED=true
  # AI_FEATURE_FORECASTS_ENABLED=true
  # AI_FEATURE_REPORTS_ENABLED=true
  # Production defaults to the internal/admin rollout stage; advance after review:
  # AI_ROLLOUT_STAGE=internal|test_company|beta|all
  # AI_ROLLOUT_INTERNAL_TENANT_IDS=company-id-1,company-id-2
  # AI_ROLLOUT_TEST_COMPANY_ID=company-id
  # AI_ROLLOUT_BETA_TENANT_IDS=company-id-3,company-id-4
  # Emergency switches; set true and restart API/worker processes to disable:
  # AI_KILL_PROVIDER_CALLS=false
  # AI_KILL_SCHEDULED_MONITORING=false
  # AI_KILL_PROPOSAL_EXECUTION=false

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Log level: debug, info, warn, error
# Development: debug
# Staging: info
# Production: warn
LOG_LEVEL=debug

# Log database queries (true/false) - useful for debugging
LOG_QUERIES=false

# Sentry DSN for error tracking (required in staging/production)
# Example: https://xxxxx@sentry.io/xxxxx
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=stock-management@1.0.0
# Apdex satisfaction threshold (ms) — keep in sync with Sentry project settings
# APDEX_T_MS=1000

# =============================================================================
# PERFORMANCE BASELINES (Phase 0)
# =============================================================================
# Used by: npm run perf:warm-top10 && npm run perf:baseline:top10
# BASELINE_URL=http://localhost:3000
# PERF_BASELINE_TOKEN=eyJ...   (JWT from login — preferred)
# PERF_BASELINE_EMAIL=admin@example.com
# PERF_BASELINE_PASSWORD=secret

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable email notifications (true/false)
ENABLE_EMAIL_NOTIFICATIONS=true

# Enable SMS notifications (true/false)
ENABLE_SMS_NOTIFICATIONS=false

# Enable cloud backup (true/false)
ENABLE_CLOUD_BACKUP=false

# Enable advanced reporting features (true/false)
ENABLE_ADVANCED_REPORTING=true

# =============================================================================
# EBM / RRA VSDC CONFIGURATION
# =============================================================================

EBM_MODE=mock
VSDC_BASE_URL=http://localhost:8080/vsdc
# Set only after RRA/integrator confirms the path for this VSDC deployment.
# Unset keeps the current /transactions/saveSales default.
# RRA_VSDC_SAVE_SALES_ENDPOINT=/trnsSales/saveSales
EBM_SALES_CONTRACT_CONFIRMED=false
EBM_SALES_SANDBOX_ALLOW_UNCONFIRMED_CONTRACT=false
# Set only to the timezone confirmed for VSDC fiscal event timestamps.
EBM_VSDC_TIME_ZONE=
RRA_SANDBOX_URL=https://sdcsandbox.rra.gov.rw
RRA_PRODUCTION_URL=https://api-ebm.rra.gov.rw
EBM_RETRY_INTERVAL_MINUTES=5
EBM_RETRY_BASE_DELAY_SECONDS=60
EBM_RETRY_BATCH_SIZE=10
EBM_MAX_RETRIES=5
EBM_CODE_SYNC_INTERVAL_HOURS=24
# Live lookup cursors stay at their configured baselines unless RRA confirms
# timezone, boundary inclusivity, and equal-timestamp semantics for that sequence.
# Required for imported-item sync in every mode; use a real taxpayer-approved
# YYYYMMDDHHmmss baseline. No default cursor is assumed by the import service.
# EBM_IMPORT_INITIAL_CURSOR=<set to the approved real 14-digit timestamp>
# EBM_STANDARD_CODE_CURSOR_SEMANTICS_CONFIRMED=true
# EBM_ITEM_CLASS_DELTA_CURSOR_CONFIRMED=true
# EBM_IMPORT_CURSOR_SEMANTICS_CONFIRMED=true
# EBM_PURCHASE_CURSOR_SEMANTICS_CONFIRMED=true
# EBM_SALES_CURSOR_SEMANTICS_CONFIRMED=true
# Set only after authorized RRA/integrator confirmation of separate branch
# transfer out/in reporting semantics. Mock mode exercises the mapping without this flag.
# EBM_STOCK_BRANCH_TRANSFER_SEMANTICS_CONFIRMED=true
# The API function matrix lists /saveStockItems/saveStockItems, while §3.3.8.2
# lists /stock/saveStockItems. Set only after authorized RRA/integrator confirmation.
# EBM_STOCK_MOVEMENT_ENDPOINT_CONFIRMED=true
# Confirms all movement DTO interpretations and calculations, including discounts,
# tax arithmetic/rounding, operator mapping, and fiscal number semantics.
# Sandbox is blocked until confirmed; production also requires approved sandbox evidence.
# EBM_STOCK_MOVEMENT_CONTRACT_CONFIRMED=true
# EBM_STOCK_MOVEMENT_SANDBOX_VERIFIED=true
# Confirm only after RRA/integrator verifies orgSarNo semantics. Outside mock,
# new movements with no source orgSarNo remain blocked until this is confirmed.
# EBM_STOCK_ORG_SARNO_SEMANTICS_CONFIRMED=true
# RRA v1.0.5 prints /stockMaster/saveStockMaster; this app's configured path is
# /stock/saveStockMaster. Enable sandbox/production stock-master dispatch only
# after the authorized RRA/integrator confirms which path is valid.
# EBM_STOCK_MASTER_ENDPOINT_CONFIRMED=true
# Also require confirmation of all stock-master field and workflow semantics;
# production requires recorded approved sandbox evidence.
# EBM_STOCK_MASTER_CONTRACT_CONFIRMED=true
# EBM_STOCK_MASTER_SANDBOX_VERIFIED=true
EBM_NOTICE_ALLOWED_HOSTS=rra.gov.rw
EBM_IMPORT_SYNC_INTERVAL_HOURS=12
EBM_PURCHASE_SYNC_INTERVAL_HOURS=6
EBM_HTTP_TIMEOUT_MS=30000
# Purchase-save requests use retrieved/local explicit values and remain fail-closed
# until source mappings and RRA code/type semantics are confirmed.
# Set only in an isolated RRA Test VSDC deployment with approved test credentials.
# RRA_VSDC_PURCHASE_SAVE_SANDBOX_ENABLED=true
# Production only, after written contract and source-mapping confirmation plus reviewed sandbox evidence.
# RRA_VSDC_PURCHASE_SAVE_CONTRACT_CONFIRMED=true
# RRA_VSDC_PURCHASE_SAVE_MAPPING_CONFIRMED=true
# Candidate item registration is blocked by default. Explicit sandbox opt-in allows
# controlled testing of the provisional mapping against isolated RRA Test VSDC.
# Production remains blocked until written contract confirmation and sandbox verification.
# Uses the §3.3.4.1 example + §3.3.4.2 select + §4.17 interpretation; not production approval.
# RRA_VSDC_ITEM_SAVE_SANDBOX_ENABLED=true
# Production only: set after written RRA/integrator confirmation and reviewed sandbox evidence.
# RRA_VSDC_ITEM_SAVE_CONTRACT_CONFIRMED=true
# RRA_VSDC_ITEM_CODE_GENERATION_CONFIRMED=true
# Item selection uses this approved 14-digit starting point in sandbox/production.
# Until cursor semantics are confirmed, every sync replays from this baseline
# and does not advance the cursor. The value below is the PDF's sample only;
# obtain the taxpayer's accepted baseline from RRA before setting it.
# RRA_ITEM_SELECT_INITIAL_CURSOR=20160523000000
# Enable incremental cursor advancement only after confirming RRA timezone,
# inclusive/exclusive boundary, and equal-timestamp behavior in writing.
# RRA_ITEM_SELECT_CURSOR_SEMANTICS_CONFIRMED=true

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup storage location (local or cloud)
# BACKUP_STORAGE=local
# BACKUP_AWS_S3_BUCKET=your-bucket-name
# BACKUP_AWS_ACCESS_KEY_ID=
# BACKUP_AWS_SECRET_ACCESS_KEY=


# Phase 1 bounded-read and explicit pool defaults.
QUERY_MAX_ROWS=500
QUERY_ENFORCE_MAX_ROWS=true
PRISMA_CONNECTION_LIMIT=20
# Set false only as a temporary emergency rollback while an endpoint is paginated.
AR_SQL_SUMMARY_ENABLED=true
