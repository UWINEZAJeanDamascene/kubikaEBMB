// Phase 10 — Fixed Assets + HR/Payroll + Budget + EBM
//
// ── Merge into Company model ─────────────────────────────────────────────
// assetCategories            AssetCategory[]
// fixedAssets                FixedAsset[]
// depreciationEntries        DepreciationEntry[]
// assetDisposalEvents        AssetDisposalEvent[]
// assetStatusHistories       AssetStatusHistory[]
// employees                  Employee[]
// salaryHistories            SalaryHistory[]
// payrolls                   Payroll[]
// payrollRuns                PayrollRun[]
// timesheets                 Timesheet[]
// employeeAdvances           EmployeeAdvance[]
// budgets                    Budget[]
// budgetLines                BudgetLine[]
// budgetWorkflowConfigs      BudgetWorkflowConfig[]
// budgetActualConsumptions   BudgetActualConsumption[]
// budgetTransfers            BudgetTransfer[]
// budgetRevisions            BudgetRevision[]
// budgetPeriodLocks          BudgetPeriodLock[]
// budgetApprovals            BudgetApproval[]
// budgetAlerts               BudgetAlert[]
// encumbrances               Encumbrance[]
// projects                   Project[]
// ebmDevices                 EbmDevice[]
// ebmCodes                   EbmCode[]
// ebmCodeClasses             EbmCodeClass[]
// ebmItemClasses             EbmItemClass[]
// ebmNotices                 EbmNotice[]
// ebmImportedItems           EbmImportedItem[]
// ebmUnmatchedPurchases      EbmUnmatchedPurchase[]
// ebmSubmissionQueues        EbmSubmissionQueue[]
// ebmAlerts                  EbmAlert[]
// ebmSyncStates              EbmSyncState[]
// budgetEntities             Budget[] @relation("BudgetEntity")

// ── Phase 10 — Fixed Assets ────────────────────────────────────────────────

model AssetCategory {
  id                                  String    @id @db.Char(24)
  companyId                           String    @map("company_id") @db.Char(24)
  name                                String
  description                         String?
  defaultUsefulLifeMonths             Int       @map("default_useful_life_months")
  defaultDepreciationMethod           String    @default("straight_line") @map("default_depreciation_method")
  defaultDecliningRate                Decimal?  @map("default_declining_rate") @db.Decimal(19, 4)
  defaultAssetAccountCode             String    @default("1700") @map("default_asset_account_code")
  defaultAccumDepreciationAccountCode String?   @default("1810") @map("default_accum_depreciation_account_code")
  defaultDepreciationExpenseAccountCode String? @default("5800") @map("default_depreciation_expense_account_code")
  rraAssetClass                       String?   @map("rra_asset_class")
  rraUsefulLifeYears                  Int?      @map("rra_useful_life_years")
  rraDepreciationMethod               String?   @map("rra_depreciation_method")
  rraDecliningRate                    Decimal?  @map("rra_declining_rate") @db.Decimal(19, 4)
  parentCategoryId                    String?   @map("parent_category_id") @db.Char(24)
  categoryCode                        String?   @map("category_code")
  isComponentizable                   Boolean   @default(false) @map("is_componentizable")
  isDepreciable                       Boolean   @default(true) @map("is_depreciable")
  defaultDepreciationFrequency        String    @default("monthly") @map("default_depreciation_frequency")
  isSystem                            Boolean   @default(false) @map("is_system")
  isDeleted                           Boolean   @default(false) @map("is_deleted")
  createdById                         String?   @map("created_by") @db.Char(24)
  createdAt                           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentCategory AssetCategory?  @relation("AssetCategoryTree", fields: [parentCategoryId], references: [id])
  childCategories AssetCategory[] @relation("AssetCategoryTree")
  fixedAssets    FixedAsset[]

  @@unique([companyId, name])
  @@index([companyId, isSystem])
  @@map("asset_categories")
}

model FixedAsset {
  id                              String    @id @db.Char(24)
  companyId                       String    @map("company_id") @db.Char(24)
  referenceNo                     String?   @map("reference_no")
  name                            String
  description                     String?
  categoryId                      String?   @map("category_id") @db.Char(24)
  assetAccountId                  String?   @map("asset_account_id") @db.Char(24)
  assetAccountCode                String    @map("asset_account_code")
  accumDepreciationAccountId      String?   @map("accum_depreciation_account_id") @db.Char(24)
  accumDepreciationAccountCode    String    @map("accum_depreciation_account_code")
  depreciationExpenseAccountId    String?   @map("depreciation_expense_account_id") @db.Char(24)
  depreciationExpenseAccountCode  String    @map("depreciation_expense_account_code")
  purchaseDate                    DateTime  @map("purchase_date") @db.Timestamptz(3)
  purchaseCost                    Decimal   @map("purchase_cost") @db.Decimal(19, 2)
  salvageValue                    Decimal   @default(0) @map("salvage_value") @db.Decimal(19, 2)
  usefulLifeMonths                Int       @map("useful_life_months")
  depreciationMethod              String    @default("straight_line") @map("depreciation_method")
  decliningRate                   Decimal?  @map("declining_rate") @db.Decimal(19, 4)
  status                          String    @default("in_transit")
  inServiceDate                   DateTime? @map("in_service_date") @db.Timestamptz(3)
  rraInServiceDate                DateTime? @map("rra_in_service_date") @db.Timestamptz(3)
  isReadyForService               Boolean   @default(false) @map("is_ready_for_service")
  disposalDate                    DateTime? @map("disposal_date") @db.Timestamptz(3)
  disposalProceeds                Decimal?  @map("disposal_proceeds") @db.Decimal(19, 2)
  disposalCosts                   Decimal?  @map("disposal_costs") @db.Decimal(19, 2)
  disposalNetProceeds               Decimal?  @map("disposal_net_proceeds") @db.Decimal(19, 2)
  disposalGainLoss                Decimal?  @map("disposal_gain_loss") @db.Decimal(19, 2)
  disposalMethod                  String?   @map("disposal_method")
  disposalNotes                   String?   @map("disposal_notes")
  disposalAuthNumber              String?   @map("disposal_auth_number")
  disposalCustomerId              String?   @map("disposal_customer_id") @db.Char(24)
  disposalEventId                 String?   @unique @map("disposal_event_id") @db.Char(24)
  disposalJournalEntryId          String?   @map("disposal_journal_entry_id") @db.Char(24)
  accumulatedDepreciation         Decimal   @default(0) @map("accumulated_depreciation") @db.Decimal(19, 2)
  netBookValue                    Decimal   @default(0) @map("net_book_value") @db.Decimal(19, 2)
  supplierId                      String?   @map("supplier_id") @db.Char(24)
  serialNumber                    String?   @map("serial_number")
  location                        String?
  departmentId                    String?   @map("department_id") @db.Char(24)
  warrantyStartDate               DateTime? @map("warranty_start_date") @db.Timestamptz(3)
  warrantyEndDate                 DateTime? @map("warranty_end_date") @db.Timestamptz(3)
  insuredValue                    Decimal?  @map("insured_value") @db.Decimal(19, 2)
  attachments                     Json      @default("[]")
  depreciationFrequency           String    @default("monthly") @map("depreciation_frequency")
  lastDepreciationPeriod          String?   @map("last_depreciation_period")
  lastDepreciationDate            DateTime? @map("last_depreciation_date") @db.Timestamptz(3)
  acquisitionMethod               String    @default("purchase") @map("acquisition_method")
  donationFairValue               Decimal?  @map("donation_fair_value") @db.Decimal(19, 2)
  constructionCompletionDate      DateTime? @map("construction_completion_date") @db.Timestamptz(3)
  custodianId                     String?   @map("custodian_id") @db.Char(24)
  isDeleted                       Boolean   @default(false) @map("is_deleted")
  deletedAt                       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById                     String    @map("created_by") @db.Char(24)
  createdAt                       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category             AssetCategory?        @relation(fields: [categoryId], references: [id])
  disposalEvent        AssetDisposalEvent?   @relation("FixedAssetDisposalEvent", fields: [disposalEventId], references: [id])
  depreciationEntries  DepreciationEntry[]
  disposalEvents       AssetDisposalEvent[]  @relation("DisposedAsset")
  tradeInDisposals     AssetDisposalEvent[]  @relation("TradeInAsset")
  statusHistories      AssetStatusHistory[]

  @@unique([companyId, referenceNo])
  @@index([companyId, status])
  @@index([companyId, categoryId])
  @@map("fixed_assets")
}

model DepreciationEntry {
  id                  String    @id @db.Char(24)
  companyId           String    @map("company_id") @db.Char(24)
  assetId             String    @map("asset_id") @db.Char(24)
  periodDate          DateTime  @map("period_date") @db.Timestamptz(3)
  depreciationAmount  Decimal   @map("depreciation_amount") @db.Decimal(19, 2)
  accumulatedBefore   Decimal   @map("accumulated_before") @db.Decimal(19, 2)
  accumulatedAfter    Decimal   @map("accumulated_after") @db.Decimal(19, 2)
  netBookValueAfter   Decimal   @map("net_book_value_after") @db.Decimal(19, 2)
  journalEntryId      String    @map("journal_entry_id") @db.Char(24)
  postedById          String    @map("posted_by") @db.Char(24)
  isReversed          Boolean   @default(false) @map("is_reversed")
  reversedById        String?   @map("reversed_by") @db.Char(24)
  reversedAt          DateTime? @map("reversed_at") @db.Timestamptz(3)
  isDeleted           Boolean   @default(false) @map("is_deleted")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset   FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([companyId, assetId, periodDate])
  @@index([companyId, periodDate])
  @@map("depreciation_entries")
}

model AssetDisposalEvent {
  id                     String    @id @db.Char(24)
  companyId              String    @map("company_id") @db.Char(24)
  assetId                String    @map("asset_id") @db.Char(24)
  disposalDate           DateTime  @map("disposal_date") @db.Timestamptz(3)
  disposalMethod         String    @map("disposal_method")
  grossProceeds          Decimal   @default(0) @map("gross_proceeds") @db.Decimal(19, 2)
  disposalCosts          Decimal   @default(0) @map("disposal_costs") @db.Decimal(19, 2)
  netProceeds            Decimal   @map("net_proceeds") @db.Decimal(19, 2)
  originalCost           Decimal   @map("original_cost") @db.Decimal(19, 2)
  accumulatedDepreciation Decimal  @map("accumulated_depreciation") @db.Decimal(19, 2)
  netBookValue           Decimal   @map("net_book_value") @db.Decimal(19, 2)
  gainLoss               Decimal   @map("gain_loss") @db.Decimal(19, 2)
  gainLossType           String    @map("gain_loss_type")
  disposalJournalEntryId String?   @map("disposal_journal_entry_id") @db.Char(24)
  tradeInAssetId         String?   @map("trade_in_asset_id") @db.Char(24)
  tradeInValue           Decimal?  @map("trade_in_value") @db.Decimal(19, 2)
  soldToCustomerId       String?   @map("sold_to_customer_id") @db.Char(24)
  saleInvoiceId          String?   @map("sale_invoice_id") @db.Char(24)
  proceedsBankAccountId  String?   @map("proceeds_bank_account_id") @db.Char(24)
  disposalAuthNumber     String?   @map("disposal_auth_number")
  rraNotified            Boolean   @default(false) @map("rra_notified")
  rraNotificationDate    DateTime? @map("rra_notification_date") @db.Timestamptz(3)
  attachments            Json      @default("[]")
  processedById          String    @map("processed_by") @db.Char(24)
  processedAt            DateTime  @default(now()) @map("processed_at") @db.Timestamptz(3)
  notes                  String?
  isReversed             Boolean   @default(false) @map("is_reversed")
  reversedAt             DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversedById           String?   @map("reversed_by") @db.Char(24)
  reversalReason         String?   @map("reversal_reason")

  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset          FixedAsset  @relation("DisposedAsset", fields: [assetId], references: [id], onDelete: Cascade)
  tradeInAsset   FixedAsset? @relation("TradeInAsset", fields: [tradeInAssetId], references: [id])
  linkedAsset    FixedAsset? @relation("FixedAssetDisposalEvent")

  @@index([companyId, assetId])
  @@index([companyId, disposalDate(sort: Desc)])
  @@index([companyId, disposalMethod])
  @@index([companyId, gainLossType])
  @@map("asset_disposal_events")
}

model AssetStatusHistory {
  id                    String   @id @db.Char(24)
  companyId             String   @map("company_id") @db.Char(24)
  assetId               String   @map("asset_id") @db.Char(24)
  fromStatus            String   @map("from_status")
  toStatus              String   @map("to_status")
  changedAt             DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)
  changedById           String   @map("changed_by") @db.Char(24)
  reason                String?
  notes                 String?
  supportingDocumentUrl String?  @map("supporting_document_url")
  locationAtChange      String?  @map("location_at_change")
  departmentIdAtChange  String?  @map("department_id_at_change") @db.Char(24)
  custodianIdAtChange   String?  @map("custodian_id_at_change") @db.Char(24)
  ipAddress             String?  @map("ip_address")
  userAgent             String?  @map("user_agent")

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset   FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([companyId, assetId, changedAt(sort: Desc)])
  @@index([companyId, fromStatus, toStatus])
  @@index([assetId, toStatus])
  @@index([changedAt(sort: Desc)])
  @@map("asset_status_histories")
}

// ── Phase 10 — HR / Payroll ────────────────────────────────────────────────

model Employee {
  id                      String    @id @db.Char(24)
  companyId               String    @map("company_id") @db.Char(24)
  employeeId              String    @map("employee_id")
  status                  String    @default("active")
  firstName               String    @map("first_name")
  lastName                String    @map("last_name")
  email                   String?
  phone                   String?
  dateOfBirth             DateTime? @map("date_of_birth") @db.Timestamptz(3)
  gender                  String?
  nationalId              String?   @map("national_id")
  hireDate                DateTime? @map("hire_date") @db.Timestamptz(3)
  terminationDate         DateTime? @map("termination_date") @db.Timestamptz(3)
  employmentType          String    @default("full-time") @map("employment_type")
  department              String?
  departmentRefId         String?   @map("department_ref_id") @db.Char(24)
  position                String?
  location                String?
  managerId               String?   @map("manager_id") @db.Char(24)
  laborType               String?   @map("labor_type")
  defaultDirectPercentage Float?    @map("default_direct_percentage")
  costCenter              String?   @map("cost_center")
  bankName                String?   @map("bank_name")
  bankAccount             String?   @map("bank_account")
  bankBranch              String?   @map("bank_branch")
  mobileMoneyNumber       String?   @map("mobile_money_number")
  taxStatus               String    @default("resident") @map("tax_status")
  isPrimaryEmployer       Boolean   @default(true) @map("is_primary_employer")
  rssbRegistrationNumber  String?   @map("rssb_registration_number")
  tinNumber               String?   @map("tin_number")
  currentSalary           Json?     @map("current_salary")
  createdById             String?   @map("created_by") @db.Char(24)
  updatedById             String?   @map("updated_by") @db.Char(24)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager         Employee?        @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates    Employee[]       @relation("EmployeeManager")
  salaryHistories SalaryHistory[]
  payrolls        Payroll[]
  timesheets      Timesheet[]
  advances        EmployeeAdvance[]

  @@unique([companyId, employeeId])
  @@index([companyId, status])
  @@index([companyId, department])
  @@index([companyId, employmentType])
  @@map("employees")
}

model SalaryHistory {
  id                 String    @id @db.Char(24)
  companyId          String    @map("company_id") @db.Char(24)
  employeeId         String    @map("employee_id") @db.Char(24)
  basicSalary        Decimal   @map("basic_salary") @db.Decimal(19, 2)
  transportAllowance Decimal   @default(0) @map("transport_allowance") @db.Decimal(19, 2)
  housingAllowance   Decimal   @default(0) @map("housing_allowance") @db.Decimal(19, 2)
  otherAllowances    Decimal   @default(0) @map("other_allowances") @db.Decimal(19, 2)
  currency           String    @default("RWF")
  effectiveDate      DateTime  @map("effective_date") @db.Timestamptz(3)
  endDate            DateTime? @map("end_date") @db.Timestamptz(3)
  reason             String?
  changedById        String?   @map("changed_by") @db.Char(24)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, effectiveDate(sort: Desc)])
  @@index([companyId, employeeId, endDate])
  @@map("salary_histories")
}

model Payroll {
  id              String    @id @db.Char(24)
  companyId       String    @map("company_id") @db.Char(24)
  employeeRefId   String?   @map("employee_id") @db.Char(24)
  employee        Json
  salary          Json
  deductions      Json      @default("{}")
  netPay          Decimal   @default(0) @map("net_pay") @db.Decimal(19, 2)
  laborAllocation Json      @default("{}") @map("labor_allocation")
  contributions   Json      @default("{}")
  period          Json
  payrollRunId    String?   @map("payroll_run_id") @db.Char(24)
  payPeriodStart  DateTime? @map("pay_period_start") @db.Timestamptz(3)
  payPeriodEnd    DateTime? @map("pay_period_end") @db.Timestamptz(3)
  recordStatus    String    @default("draft") @map("record_status")
  payment         Json      @default("{}")
  payslipGenerated Boolean  @default(false) @map("payslip_generated")
  payslipDate     DateTime? @map("payslip_date") @db.Timestamptz(3)
  notes           String?
  createdById     String?   @map("created_by") @db.Char(24)
  approvedById    String?   @map("approved_by") @db.Char(24)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeMaster Employee? @relation(fields: [employeeRefId], references: [id])
  payrollRun PayrollRun? @relation(fields: [payrollRunId], references: [id])

  @@index([companyId, payrollRunId])
  @@index([companyId, employeeRefId])
  @@map("payrolls")
}

model PayrollRun {
  id                       String    @id @db.Char(24)
  companyId                String    @map("company_id") @db.Char(24)
  referenceNo              String    @map("reference_no")
  payPeriodStart           DateTime  @map("pay_period_start") @db.Timestamptz(3)
  payPeriodEnd             DateTime  @map("pay_period_end") @db.Timestamptz(3)
  paymentDate              DateTime  @map("payment_date") @db.Timestamptz(3)
  status                   String    @default("draft")
  totalGross               Decimal   @map("total_gross") @db.Decimal(19, 2)
  totalTax                 Decimal   @map("total_tax") @db.Decimal(19, 2)
  totalOtherDeductions     Decimal   @default(0) @map("total_other_deductions") @db.Decimal(19, 2)
  totalNet                 Decimal   @map("total_net") @db.Decimal(19, 2)
  bankAccountId            String    @map("bank_account_id") @db.Char(24)
  salaryAccountId          String    @map("salary_account_id") @db.Char(24)
  taxPayableAccountId      String    @map("tax_payable_account_id") @db.Char(24)
  otherDeductionsAccountId String?   @map("other_deductions_account_id") @db.Char(24)
  journalEntryId           String?   @map("journal_entry_id") @db.Char(24)
  reversalJournalEntryId   String?   @map("reversal_journal_entry_id") @db.Char(24)
  netPayJournalId          String?   @map("net_pay_journal_id") @db.Char(24)
  payeRemitJournalId       String?   @map("paye_remit_journal_id") @db.Char(24)
  rssbRemitJournalId       String?   @map("rssb_remit_journal_id") @db.Char(24)
  notes                    String?
  postedById               String?   @map("posted_by") @db.Char(24)
  lines                    Json      @default("[]")
  employeeCount            Int       @default(0) @map("employee_count")
  remittance               Json      @default("{}")
  bankTransfer             Json      @default("{}") @map("bank_transfer")
  warnings                 Json      @default("[]")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrolls Payroll[]

  @@unique([companyId, referenceNo])
  @@index([companyId, paymentDate(sort: Desc)])
  @@index([companyId, status])
  @@index([companyId, payPeriodStart, payPeriodEnd])
  @@map("payroll_runs")
}

model Timesheet {
  id                String    @id @db.Char(24)
  companyId         String    @map("company_id") @db.Char(24)
  employeeId        String    @map("employee_id") @db.Char(24)
  employeeName      String    @map("employee_name")
  periodMonth       Int       @map("period_month")
  periodYear        Int       @map("period_year")
  periodMonthName   String?   @map("period_month_name")
  lines             Json      @default("[]")
  totalHours        Decimal   @default(0) @map("total_hours") @db.Decimal(19, 2)
  directHours       Decimal   @default(0) @map("direct_hours") @db.Decimal(19, 2)
  indirectHours     Decimal   @default(0) @map("indirect_hours") @db.Decimal(19, 2)
  directPercentage  Decimal   @default(0) @map("direct_percentage") @db.Decimal(19, 4)
  indirectPercentage Decimal  @default(0) @map("indirect_percentage") @db.Decimal(19, 4)
  status            String    @default("draft")
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz(3)
  approvedById      String?   @map("approved_by") @db.Char(24)
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz(3)
  rejectionReason   String?   @map("rejection_reason")
  createdById         String?   @map("created_by") @db.Char(24)
  updatedById         String?   @map("updated_by") @db.Char(24)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([companyId, employeeId, periodMonth, periodYear])
  @@index([companyId, status])
  @@map("timesheets")
}

model EmployeeAdvance {
  id              String    @id @db.Char(24)
  companyId       String    @map("company_id") @db.Char(24)
  employeeId      String    @map("employee_id") @db.Char(24)
  referenceNo     String    @map("reference_no")
  description     String    @default("")
  amount          Decimal   @db.Decimal(19, 2)
  amountRepaid    Decimal   @default(0) @map("amount_repaid") @db.Decimal(19, 2)
  balance         Decimal   @default(0) @db.Decimal(19, 2)
  issueDate       DateTime  @default(now()) @map("issue_date") @db.Timestamptz(3)
  dueDate         DateTime? @map("due_date") @db.Timestamptz(3)
  status          String    @default("issued")
  paymentMethod   String    @default("cash") @map("payment_method")
  bankAccountId   String?   @map("bank_account_id") @db.Char(24)
