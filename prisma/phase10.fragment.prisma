  clientId         String?   @map("client_id") @db.Char(24)
  managerId        String?   @map("manager_id") @db.Char(24)
  billingType      String    @default("none") @map("billing_type")
  contractValue    Decimal   @default(0) @map("contract_value") @db.Decimal(19, 2)
  progressPercent  Decimal   @default(0) @map("progress_percent") @db.Decimal(19, 4)
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent             Project?                  @relation("ProjectTree", fields: [parentId], references: [id])
  children           Project[]                 @relation("ProjectTree")
  budgetLines        BudgetLine[]
  actualConsumptions BudgetActualConsumption[]

  @@unique([companyId, projectCode])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([companyId, parentId])
  @@index([companyId, wbsCode])
  @@index([companyId, departmentId])
  @@index([companyId, clientId])
  @@index([companyId, isActive])
  @@map("projects")
}

