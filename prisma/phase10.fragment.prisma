  encumberedAmount Decimal  @default(0) @map("encumbered_amount") @db.Decimal(19, 2)
  actualAmount     Decimal  @default(0) @map("actual_amount") @db.Decimal(19, 2)
  notes            String   @default("")
  projectId        String?  @map("project_id") @db.Char(24)
