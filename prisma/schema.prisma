/// Cashier till sessions: the POS/direct-sale flow refuses to record a sale
/// unless the cashier has an open till.
model TillSession {
  id                 String               @id @db.Char(24)
  companyId          String               @map("company_id") @db.Char(24)
  openedById         String               @map("opened_by") @db.Char(24)
  registerId         String               @default("legacy") @map("register_id")
  registerName       String               @default("Register") @map("register_name")
  status             TillSessionStatus    @default(open)
  openingFloat       Decimal              @default(0) @map("opening_float") @db.Decimal(19, 2)
  expectedCash       Decimal              @default(0) @map("expected_cash") @db.Decimal(19, 2)
  closingCount       Decimal?             @map("closing_count") @db.Decimal(19, 2)
  cashVariance       Decimal?             @map("cash_variance") @db.Decimal(19, 2)
  cashActivity       Json                 @default("[]") @map("cash_activity")
  handoverFromId     String?              @map("handover_from_id") @db.Char(24)
  handoverToId       String?              @map("handover_to_id") @db.Char(24)
  closeNotes         String?              @map("close_notes")
  zReport            Json?                @map("z_report")
  zReportGeneratedAt DateTime?            @map("z_report_generated_at") @db.Timestamptz(3)
  openedAt           DateTime             @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt           DateTime?            @map("closed_at") @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  openedBy           User                 @relation(fields: [openedById], references: [id])
  handoverFrom       TillSession?         @relation("TillHandover", fields: [handoverFromId], references: [id])
  handovers          TillSession[]        @relation("TillHandover")
  managerApprovals   PosManagerApproval[]

  @@index([companyId, openedById, registerId, status])
  @@index([companyId, status, openedAt(sort: Desc)])
  @@map("till_sessions")
}

