  id               String           @id @db.Char(24)
  companyId        String           @map("company_id") @db.Char(24)
  registerId       String           @map("register_id") @db.Char(24)
  deviceId         String?          @map("device_id") @db.VarChar(80)
  userId           String           @map("user_id") @db.Char(24)
  status           PosSessionStatus @default(active)
  startedAt        DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  lastActivityAt   DateTime         @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  lockedAt         DateTime?        @map("locked_at") @db.Timestamptz(3)
  endedAt          DateTime?        @map("ended_at") @db.Timestamptz(3)
  endReason        String?          @map("end_reason") @db.VarChar(24)
  refreshTokenHash String?          @map("refresh_token_hash") @db.Char(64)
  refreshExpiresAt DateTime?        @map("refresh_expires_at") @db.Timestamptz(3)
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  register         PosRegister      @relation(fields: [registerId], references: [id], onDelete: Cascade)
  user             User             @relation("PosSessionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, registerId, status])
  @@index([companyId, deviceId, status])
  @@index([companyId, userId, status])
  @@index([companyId, lastActivityAt])
  @@map("pos_sessions")
}

model PosApproval {
  id          String      @id @db.Char(24)
  companyId   String      @map("company_id") @db.Char(24)
  registerId  String      @map("register_id") @db.Char(24)
  requestedBy String      @map("requested_by") @db.Char(24)
  approvedBy  String      @map("approved_by") @db.Char(24)
  action      String      @db.VarChar(40)
  context     Json?
  tokenHash   String      @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime?   @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  register    PosRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  requester   User        @relation("PosApprovalRequestedBy", fields: [requestedBy], references: [id], onDelete: Cascade)
  approver    User        @relation("PosApprovalApprovedBy", fields: [approvedBy], references: [id], onDelete: Cascade)

  @@index([companyId, registerId, action, expiresAt])
  @@index([companyId, requestedBy, createdAt])
  @@map("pos_approvals")
}

model PosAuditLog {
  id             String   @id @db.Char(24)
  companyId      String   @map("company_id") @db.Char(24)
  registerId     String?  @map("register_id") @db.Char(24)
  userId         String?  @map("user_id") @db.Char(24)
  event          String   @db.VarChar(64)
  actionId       String?  @map("action_id") @db.Char(24)
  correlationId  String?  @map("correlation_id") @db.VarChar(128)
  outcome        String?  @db.VarChar(16)
  entityType     String?  @map("entity_type") @db.VarChar(64)
  entityId       String?  @map("entity_id") @db.VarChar(128)
  metadata       Json?
  ip             String?  @db.VarChar(45)
  streamId       String?  @map("stream_id") @db.VarChar(100)
  streamSequence BigInt?  @map("stream_sequence")
  prevHash       String?  @map("prev_hash") @db.Char(64)
  hash           String?  @db.Char(64)
  hashVersion    Int?     @map("hash_version") @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([companyId, streamId, streamSequence], map: "pos_audit_logs_company_stream_sequence_key")
  // Audit references intentionally remain immutable strings rather than
  // cascading/set-null relations. Deleting a tenant, user, or register must
  // never rewrite or erase historical audit evidence.
  @@index([companyId, createdAt])
  @@index([companyId, registerId, createdAt])
  @@index([companyId, actionId])
  @@index([companyId, correlationId])
  @@index([companyId, entityType, entityId, createdAt])
  @@map("pos_audit_logs")
}

model PosAuditCheckpoint {
  id             String   @id @db.Char(24)
  companyId      String   @map("company_id") @db.Char(24)
  streamId       String   @map("stream_id") @db.VarChar(100)
  checkpointDate DateTime @map("checkpoint_date") @db.Date
  streamSequence BigInt   @map("stream_sequence")
  auditLogId     String   @map("audit_log_id") @db.Char(24)
  auditHash      String   @map("audit_hash") @db.Char(64)
  checkpointHash String   @map("checkpoint_hash") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([companyId, streamId, checkpointDate], map: "pos_audit_checkpoints_company_stream_date_key")
  @@index([companyId, checkpointDate])
  @@map("pos_audit_checkpoints")
}

model PosApprovalPolicy {
  id                        String   @id @db.Char(24)
  companyId                 String   @map("company_id") @db.Char(24)
  action                    String   @db.VarChar(40)
  enabled                   Boolean  @default(true)
  requestTtlSeconds         Int      @default(600) @map("request_ttl_seconds")
  pinApprovalTtlSeconds     Int      @default(60) @map("pin_approval_ttl_seconds")
  managerApprovalTtlSeconds Int      @default(300) @map("manager_approval_ttl_seconds")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  company                   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, action])
  @@index([companyId, enabled])
  @@map("pos_approval_policies")
}

/// Short-lived, one-use, second-person approval for sensitive POS operations.
model PosManagerApproval {
  id                    String               @id @db.Char(24)
  companyId             String               @map("company_id") @db.Char(24)
  cashierId             String               @map("cashier_id") @db.Char(24)
  managerId             String               @map("manager_id") @db.Char(24)
  tillSessionId         String?              @map("till_session_id") @db.Char(24)
  action                String               @db.VarChar(32)
  subjectId             String?              @map("subject_id") @db.Char(24)
  payloadHash           String               @map("payload_hash") @db.VarChar(64)
  expiresAt             DateTime             @map("expires_at") @db.Timestamptz(3)
  usedAt                DateTime?            @map("used_at") @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  company               Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tillSession           TillSession?         @relation(fields: [tillSessionId], references: [id], onDelete: SetNull)
  fiscalEntryQueueItems EbmSubmissionQueue[] @relation("EbmManualEntryApproval")
  approvalRequest       PosApprovalRequest?  @relation("PosApprovalRequestManagerApproval")

  @@index([companyId, cashierId, action, expiresAt])
  @@index([companyId, subjectId, action])
  @@map("pos_manager_approvals")
}

/// Cashier requests awaiting a manager decision in the POS Back Office.
model PosApprovalRequest {
  id                String              @id @db.Char(24)
  companyId         String              @map("company_id") @db.Char(24)
  registerId        String              @map("register_id") @db.Char(24)
  cashierId         String              @map("cashier_id") @db.Char(24)
  tillSessionId     String?             @map("till_session_id") @db.Char(24)
  action            String              @db.VarChar(32)
  subjectId         String?             @map("subject_id") @db.Char(24)
  payload           Json
  payloadHash       String              @map("payload_hash") @db.VarChar(64)
  status            String              @default("PENDING") @db.VarChar(16)
  decisionById      String?             @map("decision_by_id") @db.Char(24)
  assignedManagerId String?             @map("assigned_manager_id") @db.Char(24)
  decisionReason    String?             @map("decision_reason") @db.VarChar(500)
  decisionAt        DateTime?           @map("decision_at") @db.Timestamptz(3)
  managerApprovalId String?             @unique @map("manager_approval_id") @db.Char(24)
  expiresAt         DateTime            @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  register          PosRegister         @relation(fields: [registerId], references: [id], onDelete: Cascade)
  cashier           User                @relation("PosApprovalRequestCashier", fields: [cashierId], references: [id], onDelete: Cascade)
  decisionBy        User?               @relation("PosApprovalRequestDecisionBy", fields: [decisionById], references: [id], onDelete: SetNull)
  assignedManager   User?               @relation("PosApprovalRequestAssignedManager", fields: [assignedManagerId], references: [id], onDelete: SetNull)
  managerApproval   PosManagerApproval? @relation("PosApprovalRequestManagerApproval", fields: [managerApprovalId], references: [id], onDelete: SetNull)

  @@index([companyId, status, createdAt])
  @@index([companyId, registerId, createdAt])
  @@index([companyId, assignedManagerId, status, createdAt], map: "pos_appr_req_company_mgr_status_created_idx")
  @@map("pos_approval_requests")
}

/// Manager-approved POS promotion rules with explicit validity windows.
model PosPromotion {
  id           String   @id @db.Char(24)
  companyId    String   @map("company_id") @db.Char(24)
  name         String   @db.VarChar(120)
  code         String   @db.VarChar(40)
  discountType String   @map("discount_type") @db.VarChar(16)
  value        Decimal  @db.Decimal(19, 4)
  startsAt     DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime @map("ends_at") @db.Timestamptz(3)
  isActive     Boolean  @default(true) @map("is_active")
  createdById  String   @map("created_by_id") @db.Char(24)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId, isActive, startsAt, endsAt])
  @@map("pos_promotions")
}

/// Promotional discounts. Voucher secrets are stored only as a SHA-256 hash;
/// the plaintext code is returned once when the voucher is generated.
model PosVoucher {
  id                      String                 @id @db.Char(24)
  companyId               String                 @map("company_id") @db.Char(24)
  batchId                 String?                @map("batch_id") @db.Char(24)
  codeHash                String                 @map("code_hash") @db.Char(64)
  codeSuffix              String                 @map("code_suffix") @db.VarChar(8)
  name                    String                 @db.VarChar(120)
  discountType            String                 @map("discount_type") @db.VarChar(16)
  value                   Decimal                @db.Decimal(19, 4)
  maxDiscountRwf          Int?                   @map("max_discount_rwf")
  minSpendRwf             Int                    @default(0) @map("min_spend_rwf")
  totalUsageLimit         Int?                   @map("total_usage_limit")
  perCustomerUsageLimit   Int?                   @map("per_customer_usage_limit")
  singleUse               Boolean                @default(false) @map("single_use")
  canCombineWithDiscounts Boolean                @default(false) @map("can_combine_with_discounts")
  startsAt                DateTime               @map("starts_at") @db.Timestamptz(3)
  endsAt                  DateTime               @map("ends_at") @db.Timestamptz(3)
  customerIds             Json                   @default("[]") @map("customer_ids")
  customerGroupTags       Json                   @default("[]") @map("customer_group_tags")
  excludedProductIds      Json                   @default("[]") @map("excluded_product_ids")
  excludedCategoryIds     Json                   @default("[]") @map("excluded_category_ids")
  status                  String                 @default("ACTIVE") @db.VarChar(16)
  createdById             String                 @map("created_by_id") @db.Char(24)
  updatedById             String?                @map("updated_by_id") @db.Char(24)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  company                 Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  redemptions             PosVoucherRedemption[]

  @@unique([companyId, codeHash])
  @@index([companyId, status, startsAt, endsAt])
  @@index([companyId, batchId])
  @@map("pos_vouchers")
}

/// Reservations become redemptions only in the same transaction that completes
/// the POS sale. Released and expired reservations remain for audit/history.
model PosVoucherRedemption {
  id                   String     @id @db.Char(24)
  companyId            String     @map("company_id") @db.Char(24)
  voucherId            String     @map("voucher_id") @db.Char(24)
  clientId             String?    @map("client_id") @db.Char(24)
  cashierId            String     @map("cashier_id") @db.Char(24)
  tillSessionId        String?    @map("till_session_id") @db.Char(24)
  cartKeyHash          String     @map("cart_key_hash") @db.Char(64)
  reservationTokenHash String     @unique @map("reservation_token_hash") @db.Char(64)
  invoiceId            String?    @map("invoice_id") @db.Char(24)
  codeSuffix           String     @map("code_suffix") @db.VarChar(8)
  status               String     @default("RESERVED") @db.VarChar(16)
  discountRwf          Int        @default(0) @map("discount_rwf")
  pricingSnapshot      Json       @map("pricing_snapshot")
  expiresAt            DateTime   @map("expires_at") @db.Timestamptz(3)
  redeemedAt           DateTime?  @map("redeemed_at") @db.Timestamptz(3)
  restoredAt           DateTime?  @map("restored_at") @db.Timestamptz(3)
  restoredById         String?    @map("restored_by_id") @db.Char(24)
  restoreReason        String?    @map("restore_reason") @db.VarChar(500)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  company              Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucher              PosVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([companyId, voucherId, status, expiresAt])
  @@index([companyId, clientId, voucherId, status])
  @@index([companyId, invoiceId])
  @@map("pos_voucher_redemptions")
}

/// Durable cashier lockout state for repeated invalid voucher-code attempts.
/// Only the hash of an attempted code is stored; plaintext codes are never logged.
model PosVoucherCodeAttempt {
  id              String    @id @db.Char(24)
  companyId       String    @map("company_id") @db.Char(24)
  cashierId       String    @map("cashier_id") @db.Char(24)
  attemptCount    Int       @default(0) @map("attempt_count")
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(3)
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, cashierId])
  @@index([companyId, lockedUntil])
  @@map("pos_voucher_code_attempts")
}

/// Monetary stored value accepted as POS tender. Codes are stored as hashes;
/// all balance movements are kept in PosStoredValueLedger for auditability.
model PosStoredValueAccount {
  id                  String                 @id @db.Char(24)
  companyId           String                 @map("company_id") @db.Char(24)
  clientId            String?                @map("client_id") @db.Char(24)
  kind                String                 @db.VarChar(20)
  codeHash            String?                @map("code_hash") @db.VarChar(64)
  codeSuffix          String?                @map("code_suffix") @db.VarChar(8)
  currencyCode        String                 @default("RWF") @map("currency_code") @db.VarChar(3)
  balance             Decimal                @default(0) @db.Decimal(19, 2)
  isActive            Boolean                @default(true) @map("is_active")
  expiresAt           DateTime?              @map("expires_at") @db.Timestamptz(3)
  createdById         String?                @map("created_by_id") @db.Char(24)
  replacementKey      String?                @map("replacement_key") @db.VarChar(100)
  replacesAccountId   String?                @map("replaces_account_id") @db.Char(24)
  replacedByAccountId String?                @map("replaced_by_account_id") @db.Char(24)
  replacedAt          DateTime?              @map("replaced_at") @db.Timestamptz(3)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  company             Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledger              PosStoredValueLedger[]

  @@unique([companyId, codeHash])
  @@unique([companyId, replacementKey])
  @@unique([companyId, clientId, kind, currencyCode])
  @@index([companyId, kind, isActive])
  @@index([companyId, clientId, kind])
  @@map("pos_stored_value_accounts")
}

model PosStoredValueLedger {
  id             String                   @id @db.Char(24)
  companyId      String                   @map("company_id") @db.Char(24)
  accountId      String                   @map("account_id") @db.Char(24)
  posPaymentId   String?                  @map("pos_payment_id") @db.Char(24)
  idempotencyKey String?                  @map("idempotency_key") @db.VarChar(100)
  operationType  PosStoredValueOperation? @map("operation_type")
  invoiceId      String?                  @map("invoice_id") @db.Char(24)
  kind           String                   @db.VarChar(20)
  entryType      String                   @map("entry_type") @db.VarChar(20)
  amount         Decimal                  @db.Decimal(19, 2)
  balanceAfter   Decimal                  @map("balance_after") @db.Decimal(19, 2)
  reference      String?                  @db.VarChar(120)
  notes          String?
  createdById    String?                  @map("created_by_id") @db.Char(24)
  journalEntryId String?                  @map("journal_entry_id") @db.Char(24)
  postingStatus  String                   @default("not_required") @map("posting_status") @db.VarChar(16)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  company        Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account        PosStoredValueAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  posPayment     PosPayment?              @relation(fields: [posPaymentId], references: [id], onDelete: Restrict)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, accountId, createdAt(sort: Desc)])
  @@index([companyId, invoiceId])
  @@index([companyId, posPaymentId])
  @@index([companyId, postingStatus])
  @@map("pos_stored_value_ledger")
}

model PosPayment {
  id                   String                          @id @db.Char(24)
  companyId            String                          @map("company_id") @db.Char(24)
  saleId               String                          @map("sale_id") @db.Char(24)
  shiftId              String                          @map("shift_id") @db.Char(24)
  registerId           String                          @map("register_id") @db.Char(24)
  cashierId            String                          @map("cashier_id") @db.Char(24)
  method               PosPaymentMethod
  status               PosPaymentStatus                @default(PENDING)
  amount               Int
  tendered             Int?
  changeGiven          Int?                            @map("change_given")
  reference            String?
  customerId           String?                         @map("customer_id") @db.Char(24)
  providerName         String?                         @map("provider_name")
  providerTxId         String?                         @map("provider_tx_id")
  normalizedReference  String?                         @map("normalized_reference") @db.VarChar(160)
  payerPhone           String?                         @map("payer_phone")
  externalRef          String?                         @map("external_ref")
  reconciliationStatus PosPaymentReconciliationStatus? @map("reconciliation_status")
  confirmedAt          DateTime?                       @map("confirmed_at") @db.Timestamptz(3)
  confirmedById        String?                         @map("confirmed_by_id") @db.Char(24)
  reconciledAt         DateTime?                       @map("reconciled_at") @db.Timestamptz(3)
  reconciledById       String?                         @map("reconciled_by_id") @db.Char(24)
  note                 String?
  idempotencyKey       String                          @map("idempotency_key") @db.VarChar(100)
  createdAt            DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt          DateTime?                       @map("completed_at") @db.Timestamptz(3)
  company              Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale                 Invoice                         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  shift                PosShift                        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  register             PosRegister                     @relation(fields: [registerId], references: [id], onDelete: Restrict)
  cashier              User                            @relation("PosPaymentCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  confirmedBy          User?                           @relation("PosPaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  reconciledBy         User?                           @relation("PosPaymentReconciledBy", fields: [reconciledById], references: [id], onDelete: SetNull)
  customer             Client?                         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  attempts             PosPaymentAttempt[]
  providerEvents       PosProviderEvent[]
  refunds              PosPaymentRefund[]
  storedValueLedger    PosStoredValueLedger[]
  cheque               PosCheque?

  @@unique([companyId, id])
  @@unique([companyId, idempotencyKey])
  @@unique([companyId, externalRef])
  @@unique([companyId, method, normalizedReference])
  @@index([companyId, saleId])
  @@index([companyId, shiftId, method, status])
  @@index([companyId, registerId, createdAt])
  @@index([companyId, method, reconciliationStatus, createdAt], map: "pos_payments_company_id_method_reconciliation_status_created_at")
  @@index([companyId, cashierId, createdAt])
  @@map("pos_payments")
}

model PosChequeDeposit {
  id                String      @id @db.Char(24)
  companyId         String      @map("company_id") @db.Char(24)
  bankAccountId     String      @map("bank_account_id") @db.Char(24)
  bankAccountCode   String      @map("bank_account_code") @db.VarChar(32)
  idempotencyKey    String      @map("idempotency_key") @db.VarChar(100)
  payloadHash       String      @map("payload_hash") @db.Char(64)
  depositDate       DateTime    @map("deposit_date") @db.Timestamptz(3)
  bankSlipReference String      @map("bank_slip_reference") @db.VarChar(100)
  totalAmount       Int         @map("total_amount")
  postingStatus     String      @default("pending") @map("posting_status") @db.VarChar(16)
  journalEntryId    String?     @map("journal_entry_id") @db.Char(24)
  createdById       String      @map("created_by_id") @db.Char(24)
  approvedById      String?     @map("approved_by_id") @db.Char(24)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount       BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  cheques           PosCheque[]

  @@unique([companyId, idempotencyKey])
  @@index([companyId, depositDate])
  @@index([companyId, postingStatus])
  @@map("pos_cheque_deposits")
}

model PosCheque {
  id                       String            @id @db.Char(24)
  companyId                String            @map("company_id") @db.Char(24)
  invoiceId                String            @map("invoice_id") @db.Char(24)
  paymentId                String?           @unique @map("payment_id") @db.Char(24)
  tenderIndex              Int               @map("tender_index")
  reference                String            @db.VarChar(160)
  amount                   Int
  status                   String            @default("in_hand") @db.VarChar(16)
  chequesInHandAccountCode String?           @map("cheques_in_hand_account_code") @db.VarChar(32)
  salePostingStatus        String            @default("pending") @map("sale_posting_status") @db.VarChar(16)
  saleJournalEntryId       String?           @map("sale_journal_entry_id") @db.Char(24)
  depositId                String?           @map("deposit_id") @db.Char(24)
  depositedAt              DateTime?         @map("deposited_at") @db.Timestamptz(3)
