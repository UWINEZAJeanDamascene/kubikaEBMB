  fiscalYear           Int?     @map("fiscal_year")
  accountingPeriod     String?  @map("accounting_period")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, transactionDate(sort: Desc)])
  @@index([companyId, clientId, transactionDate(sort: Desc)])
  @@index([companyId, invoiceId, transactionDate(sort: Desc)])
  @@index([companyId, transactionType])
  @@index([companyId, reconciliationStatus])
  @@index([companyId, fiscalYear, accountingPeriod])
  @@index([companyId, sourceType, sourceId])
  @@index([reversedFrom])
  @@index([reversedBy])
  @@map("ar_transaction_ledger")
}

/// AP transaction ledger — the payables counterpart of ArTransactionLedger.
/// Same design decisions: growable sets as Strings, wholesale JSON for the
/// optional metadata/discrepancy blobs.
model ApTransactionLedger {
  id                   String    @id @db.Char(24)
  companyId            String    @map("company_id") @db.Char(24)
  supplierId           String    @map("supplier_id") @db.Char(24)
  transactionType      String    @map("transaction_type")
  transactionDate      DateTime  @default(now()) @map("transaction_date") @db.Timestamptz(3)
  referenceNo          String?   @map("reference_no")
  description          String
  amount               Decimal   @db.Decimal(19, 4)
  direction            String
  supplierBalanceAfter Decimal?  @map("supplier_balance_after") @db.Decimal(19, 4)
  grnBalanceAfter      Decimal?  @map("grn_balance_after") @db.Decimal(19, 4)
  grnId                String?   @map("grn_id") @db.Char(24)
  paymentId            String?   @map("payment_id") @db.Char(24)
  sourceType           String    @map("source_type")
  sourceId             String    @map("source_id") @db.Char(24)
  sourceReference      String?   @map("source_reference")
  createdById          String?   @map("created_by") @db.Char(24)
  reconciliationStatus String    @default("pending") @map("reconciliation_status")
  verifiedAt           DateTime? @map("verified_at") @db.Timestamptz(3)
  discrepancyDetails   Json?     @map("discrepancy_details")
  metadata             Json?
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier             Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([companyId, supplierId, transactionDate(sort: Desc)])
  @@index([companyId, transactionType, transactionDate(sort: Desc)])
  @@index([companyId, reconciliationStatus, transactionDate(sort: Desc)])
  @@index([companyId, sourceType, sourceId])
  @@map("ap_transaction_ledger")
}

