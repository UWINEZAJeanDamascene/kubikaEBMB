}

/// Customer prepayments recognised as revenue over time. `recognitions` holds the
/// schedule rows ({ _id, amount, date, description, status, journalEntryId }).
model DeferredRevenue {
  id                 String   @id @db.Char(24)
  companyId          String   @map("company_id") @db.Char(24)
  referenceNo        String   @map("reference_no")
  customer           String   @default("")
  description        String
  totalAmount        Decimal  @map("total_amount") @db.Decimal(19, 2)
  revenueAccountCode String   @map("revenue_account_code")
  paymentMethod      String   @default("cash") @map("payment_method")
  bankAccountId      String?  @map("bank_account_id") @db.Char(24)
  startDate          DateTime @map("start_date") @db.Timestamptz(3)
  endDate            DateTime @map("end_date") @db.Timestamptz(3)
  frequency          String   @default("monthly")
  status             String   @default("active")
  remainingBalance   Decimal  @default(0) @map("remaining_balance") @db.Decimal(19, 2)
  totalRecognized    Decimal  @default(0) @map("total_recognized") @db.Decimal(19, 2)
  recognitions       Json     @default("[]")
  journalEntryId     String?  @map("journal_entry_id") @db.Char(24)
