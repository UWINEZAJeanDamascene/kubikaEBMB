/// Durable idempotency ledger for POS checkout requests. The unique composite
/// key prevents network retries from creating duplicate invoices or stock moves.
model PosSaleRequest {
  companyId   String   @map("company_id") @db.Char(24)
  requestKey  String   @map("request_key") @db.VarChar(100)
  createdById String   @map("created_by_id") @db.Char(24)
  payloadHash String   @map("payload_hash") @db.Char(64)
  invoiceId   String?  @map("invoice_id") @db.Char(24)
  status      String   @default("processing")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([companyId, requestKey])
  @@index([createdAt])
  @@map("pos_sale_requests")
}

/// Shared request idempotency ledger for POS mutations that do not already
/// have a domain-specific business ledger. Ambiguous outcomes are quarantined
/// and never executed a second time automatically.
model PosIdempotencyRecord {
  id                String    @id @db.Char(24)
  companyId         String    @map("company_id") @db.Char(24)
  scope             String    @db.VarChar(220)
  idempotencyKey    String    @map("idempotency_key") @db.VarChar(160)
  payloadHash       String    @map("payload_hash") @db.Char(64)
  actorId           String?   @map("actor_id") @db.Char(24)
  registerId        String?   @map("register_id") @db.Char(24)
  status            String    @default("PROCESSING") @db.VarChar(24)
  responseStatus    Int?      @map("response_status")
  resultReferenceId String?   @map("result_reference_id") @db.Char(24)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  leaseExpiresAt    DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)

  @@unique([companyId, scope, idempotencyKey], map: "pos_idempotency_records_scope_key")
  @@index([companyId, status, createdAt], map: "pos_idempotency_records_status_idx")
  @@index([companyId, status, leaseExpiresAt], map: "pos_idempotency_records_lease_idx")
  @@index([companyId, registerId, createdAt], map: "pos_idempotency_records_register_idx")
  @@map("pos_idempotency_records")
}

/// Encrypted, replayable HTTP outcome referenced by the idempotency ledger.
/// Keeping the payload separate lets the ledger remain a compact pointer and
/// avoids exposing response contents in queue/reconciliation queries.
model PosIdempotencyResult {
  id                  String   @id @db.Char(24)
  companyId           String   @map("company_id") @db.Char(24)
  idempotencyRecordId String   @unique @map("idempotency_record_id") @db.Char(24)
  payloadCiphertext   String   @map("payload_ciphertext") @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, createdAt], map: "pos_idempotency_results_company_created_idx")
  @@map("pos_idempotency_results")
}

/// Auditable manager-authorized re-key operations used to recover a distinct
/// saved checkout when its browser idempotency key belongs to another sale.
model PosSaleRequestRecovery {
  id                    String   @id @db.Char(24)
  companyId             String   @map("company_id") @db.Char(24)
