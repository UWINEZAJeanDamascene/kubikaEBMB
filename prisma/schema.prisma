/// Short-lived, one-use, second-person approval for sensitive POS operations.
model PosManagerApproval {
  id            String       @id @db.Char(24)
  companyId     String       @map("company_id") @db.Char(24)
  cashierId     String       @map("cashier_id") @db.Char(24)
