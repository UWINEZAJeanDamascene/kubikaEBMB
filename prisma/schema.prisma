  reason         String             @db.VarChar(500)
  idempotencyKey String             @map("idempotency_key") @db.VarChar(100)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice        Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  submission     EbmSubmissionQueue @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  register       PosRegister?       @relation(fields: [registerId], references: [id], onDelete: Restrict)

  @@unique([companyId, idempotencyKey])
  @@unique([companyId, invoiceId, copyNumber])
  @@index([companyId, invoiceId, createdAt])
  @@map("pos_ebm_receipt_reprints")
}

/// Public digital receipt links. Only a SHA-256 hash is stored; the bearer
/// token is returned once to the authorized user and is never persisted.
model PosPublicReceiptToken {
  id            String    @id @db.Char(24)
  companyId     String    @map("company_id") @db.Char(24)
  invoiceId     String    @map("invoice_id") @db.Char(24)
  tokenHash     String    @unique(map: "pos_public_receipt_tokens_token_hash_key") @map("token_hash") @db.Char(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  firstViewedAt DateTime? @map("first_viewed_at") @db.Timestamptz(3)
  lastViewedAt  DateTime? @map("last_viewed_at") @db.Timestamptz(3)
  viewCount     Int       @default(0) @map("view_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId, invoiceId, createdAt])
  @@index([companyId, expiresAt, revokedAt])
  @@map("pos_public_receipt_tokens")
}

/// Informational POS documents. These never enter sale, journal, stock, fiscal,
/// or shift-total workflows.
model PosNonPostingDocument {
  id                 String      @id @db.Char(24)
  companyId          String      @map("company_id") @db.Char(24)
  registerId         String      @map("register_id") @db.Char(24)
  createdById        String      @map("created_by_id") @db.Char(24)
  documentNumber     String      @map("document_number") @db.VarChar(80)
  documentType       String      @map("document_type") @db.VarChar(20)
  status             String      @default("open") @db.VarChar(20)
  documentData       Json        @map("document_data")
  totalAmount        Decimal     @default(0) @map("total_amount") @db.Decimal(19, 2)
  conversionKey      String?     @unique @map("conversion_key") @db.VarChar(100)
  convertedInvoiceId String?     @unique @map("converted_invoice_id") @db.Char(24)
  convertedAt        DateTime?   @map("converted_at") @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  company            Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  register           PosRegister @relation(fields: [registerId], references: [id], onDelete: Restrict)

  @@unique([companyId, documentNumber])
  @@index([companyId, registerId, documentType, status, createdAt(sort: Desc)])
  @@map("pos_non_posting_documents")
}

model EbmAlert {
