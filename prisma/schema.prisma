/// In-app notification. `type` and `severity` are plain strings rather than
/// Prisma enums: the Mongoose schema listed 24 notification types and the set
/// grows with features, so an enum would force a migration for every new alert.
model Notification {
  id        String    @id @db.Char(24)
  companyId String    @map("company_id") @db.Char(24)
  userId    String    @map("user_id") @db.Char(24)
  type      String
  title     String
  message   String
  severity  String    @default("info")
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  link      String?
  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, isRead, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Per-company notification preferences. The Mongoose document nested these
/// under emailNotifications / smsNotifications / preferences; they are flattened
/// into columns here so defaults are enforced by the database, and the API shape
/// is rebuilt by the mapper. Phone lists stay as native Postgres arrays.
model NotificationSettings {
  id                    String   @id @db.Char(24)
  companyId             String   @unique @map("company_id") @db.Char(24)
  emailEnabled          Boolean  @default(true) @map("email_enabled")
  emailInvoiceDelivery  Boolean  @default(false) @map("email_invoice_delivery")
  emailPaymentReminders Boolean  @default(true) @map("email_payment_reminders")
  emailLowStockAlerts   Boolean  @default(true) @map("email_low_stock_alerts")
  emailDailySummary     Boolean  @default(false) @map("email_daily_summary")
  emailWeeklySummary    Boolean  @default(true) @map("email_weekly_summary")
  smsEnabled            Boolean  @default(false) @map("sms_enabled")
  smsCriticalOnly       Boolean  @default(true) @map("sms_critical_only")
  smsAdminPhones        String[] @map("sms_admin_phones")
  lowStockThreshold     Decimal  @default(10) @map("low_stock_threshold") @db.Decimal(19, 4)
  paymentReminderDays   Int      @default(3) @map("payment_reminder_days")
  summarySendTime       String   @default("09:00") @map("summary_send_time")
  largeOrderThreshold   Decimal  @default(10000) @map("large_order_threshold") @db.Decimal(19, 4)
  criticalAlertPhones   String[] @map("critical_alert_phones")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

/// Centralized tax-event ledger — one row per tax-relevant journal line.
/// `tax_type`, `direction`, `source_type` and `status` are plain strings (not
/// Prisma enums) so new tax categories can be added without a migration.
model TaxTransaction {
  id                 String           @id @db.Char(24)
  companyId          String           @map("company_id") @db.Char(24)
  taxType            String           @map("tax_type")
  direction          String
  amount             Decimal          @db.Decimal(19, 4)
  netAmount          Decimal          @default(0) @map("net_amount") @db.Decimal(19, 4)
  grossAmount        Decimal          @default(0) @map("gross_amount") @db.Decimal(19, 4)
  taxRate            Float            @default(0) @map("tax_rate")
  sourceType         String           @map("source_type")
  sourceId           String?          @map("source_id") @db.Char(24)
  sourceReference    String?          @map("source_reference")
  journalEntryId     String?          @map("journal_entry_id") @db.Char(24)
  journalEntryNumber String?          @map("journal_entry_number")
  accountCode        String           @map("account_code")
  taxRateId          String?          @map("tax_rate_id") @db.Char(24)
  taxCode            String?          @map("tax_code")
  periodMonth        Int?             @map("period_month")
  periodYear         Int?             @map("period_year")
  date               DateTime         @db.Timestamptz(3)
  description        String?
  status             String           @default("posted")
  reversalOfId       String?          @map("reversal_of_id") @db.Char(24)
  createdById        String?          @map("created_by") @db.Char(24)
  metadata           Json             @default("{}")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntry       JournalEntry?    @relation(fields: [journalEntryId], references: [id])
  reversalOf         TaxTransaction?  @relation("TaxTransactionReversal", fields: [reversalOfId], references: [id])
  reversals          TaxTransaction[] @relation("TaxTransactionReversal")
  linkedTaxRate      TaxRate?         @relation(fields: [taxRateId], references: [id])

  @@index([companyId, date(sort: Desc)])
  @@index([companyId, taxType, date(sort: Desc)])
  @@index([companyId, direction, date(sort: Desc)])
  @@index([companyId, sourceType, date(sort: Desc)])
  @@index([companyId, status, date(sort: Desc)])
  @@index([companyId, periodYear, periodMonth])
  @@index([companyId, taxType, direction, status, date(sort: Desc)])
  @@index([journalEntryId])
  @@index([companyId, journalEntryId])
  @@map("tax_transactions")
}

/// AR transaction ledger — an append-only audit trail of every event that moves
/// a client's receivable balance.
///
/// `transactionType` / `sourceType` / `direction` / `reconciliationStatus` are
/// Strings rather than Prisma enums, matching the decision taken for
/// Notification: these sets grow as features are added, and an enum turns each
/// addition into a schema migration.
///
/// `metadata` and `discrepancyDetails` stay JSON. They were nested optional
/// objects in Mongo, are written wholesale and never filtered on, so columns
/// would add width without buying a query.
model ArBadDebtWriteoff {
  id                    String    @id @db.Char(24)
  companyId             String    @map("company_id") @db.Char(24)
  referenceNo           String    @map("reference_no")
  invoiceId             String    @map("invoice_id") @db.Char(24)
  clientId              String    @map("client_id") @db.Char(24)
  writeoffDate          DateTime  @default(now()) @map("writeoff_date") @db.Timestamptz(3)
  amount                Decimal   @db.Decimal(19, 2)
  reason                String
  notes                 String?
  journalEntryId        String?   @map("journal_entry_id") @db.Char(24)
  postedById            String?   @map("posted_by") @db.Char(24)
  status                String    @default("draft")
  reversedAt            DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversedById          String?   @map("reversed_by") @db.Char(24)
  reversalReason        String?   @map("reversal_reason")
  reverseJournalEntryId String?   @map("reverse_journal_entry_id") @db.Char(24)
  createdById           String    @map("created_by") @db.Char(24)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  client                Client    @relation(fields: [clientId], references: [id])
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice               Invoice   @relation(fields: [invoiceId], references: [id])

  @@unique([companyId, referenceNo], map: "ar_bad_debt_writeoffs_company_reference_key")
  @@index([companyId, clientId], map: "ar_bad_debt_writeoffs_company_client_idx")
  @@index([companyId, writeoffDate(sort: Desc)], map: "ar_bad_debt_writeoffs_company_date_idx")
  @@index([companyId, invoiceId], map: "ar_bad_debt_writeoffs_company_invoice_idx")
  @@index([companyId, status], map: "ar_bad_debt_writeoffs_company_status_idx")
  @@map("ar_bad_debt_writeoffs")
}

