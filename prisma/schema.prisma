generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Platform-wide subscription package catalog (pricing tiers shown on signup/pricing pages).
model SubscriptionPlanCatalog {
  id                   String       @id @db.Char(24)
  key                  String       @unique
  name                 String
  description          String       @default("")
  features             String[]     @default([])
  modules              String[]     @default([])
  outcomes             String[]     @default([])
  badge                String       @default("")
  icon                 String       @default("")
  featured             Boolean      @default(false)
  buttonLabel          String       @default("") @map("button_label")
  defaultBillingAmount Decimal      @default(0) @map("default_billing_amount") @db.Decimal(19, 4)
  defaultBillingCycle  BillingCycle @default(monthly) @map("default_billing_cycle")
  isActive             Boolean      @default(true) @map("is_active")
  sortOrder            Int          @default(0) @map("sort_order")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive])
  @@index([sortOrder])
  @@map("subscription_plan_catalog")
}

model Testimonial {
  id        String   @id @db.Char(24)
  name      String
  role      String
  company   String
  avatar    String?
  content   String
  rating    Float    @default(5)
  isActive  Boolean  @default(true) @map("is_active")
  order     Int      @default(0)
  createdBy String?  @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([order])
  @@index([isActive])
  @@map("testimonials")
}

model AIFinding {
  id                  String   @id @db.Char(24)
  findingId           String   @map("finding_id")
  company             String   @db.Char(24)
  domain              String
  ruleId              String   @map("rule_id")
  title               String
  summary             String
  severity            String
  confidence          Float
  evidenceFactIds     String[] @default([]) @map("evidence_fact_ids")
  recommendedNextStep String?  @map("recommended_next_step")
  status              String   @default("open")
  metadata            Json     @default("{}")
  firstDetectedAt     DateTime @default(now()) @map("first_detected_at") @db.Timestamptz(3)
  lastDetectedAt      DateTime @default(now()) @map("last_detected_at") @db.Timestamptz(3)
  occurrenceCount     Int      @default(1) @map("occurrence_count")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([company, findingId])
  @@index([company, status, severity])
  @@index([company, domain, lastDetectedAt])
  @@map("ai_findings")
}

model AIBriefing {
  id              String   @id @db.Char(24)
  companyId       String   @map("company_id") @db.Char(24)
  briefingDate    DateTime @map("briefing_date") @db.Date
  summary         String
  findings        Json     @default("[]")
  recommendations Json     @default("[]")
  facts           Json     @default("[]")
  evidenceFactIds String[] @default([]) @map("evidence_fact_ids")
  warnings        String[] @default([])
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, briefingDate])
  @@index([companyId, briefingDate(sort: Desc)])
  @@map("ai_briefings")
}

model AIOperationalEvent {
  id         String   @id @db.Char(24)
  eventType  String   @map("event_type")
  companyId  String?  @map("company_id") @db.Char(24)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  durationMs Int?     @map("duration_ms")
  provider   String?
  outcome    String?
  metadata   Json     @default("{}")

  @@index([eventType, occurredAt(sort: Desc)])
  @@index([companyId, eventType, occurredAt(sort: Desc)])
  @@map("ai_operational_events")
}

model AIReport {
  id                 String   @id @db.Char(24)
  reportId           String   @map("report_id")
  companyId          String   @map("company_id") @db.Char(24)
  createdBy          String   @map("created_by") @db.Char(24)
  reportType         String   @map("report_type")
  title              String
  dateRange          Json     @map("date_range")
  executiveSummary   String   @map("executive_summary")
  findings           Json     @default("[]")
  evidence           Json     @default("[]")
  calculations       Json     @default("[]")
  recommendations    Json     @default("[]")
  missingDataCaveats String[] @default([]) @map("missing_data_caveats")
  generatedBy        Json     @map("generated_by")
  metadata           Json     @default("{}")
  generatedAt        DateTime @default(now()) @map("generated_at") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([companyId, reportId])
  @@index([companyId, reportType, generatedAt(sort: Desc)])
  @@map("ai_reports")
}

model AIForecast {
  id              String   @id @db.Char(24)
  forecastId      String   @map("forecast_id")
  companyId       String   @map("company_id") @db.Char(24)
  createdBy       String   @map("created_by") @db.Char(24)
  forecastType    String   @map("forecast_type")
  dateRange       Json     @map("date_range")
  horizon         Int
  status          String
  method          String
  confidence      String
  forecast        Json
  assumptions     Json     @default("[]")
  sourceFacts     Json     @default("[]") @map("source_facts")
  backtestMetrics Json     @default("{}") @map("backtest_metrics")
  modelVersion    String   @map("model_version")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([companyId, forecastId])
  @@index([companyId, forecastType, createdAt(sort: Desc)])
  @@map("ai_forecasts")
}

model AIFindingUserState {
  id           String    @id @db.Char(24)
  companyId    String    @map("company_id") @db.Char(24)
  userId       String    @map("user_id") @db.Char(24)
  findingId    String    @map("finding_id")
  state        String    @default("active")
  snoozedUntil DateTime? @map("snoozed_until") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, userId, findingId])
  @@index([companyId, userId, state, snoozedUntil])
  @@map("ai_finding_user_states")
}

model AIAlertDailyUsage {
  id         String   @id @db.Char(24)
  companyId  String   @map("company_id") @db.Char(24)
  userId     String   @map("user_id") @db.Char(24)
  alertDate  DateTime @map("alert_date") @db.Date
  alertCount Int      @default(0) @map("alert_count")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, userId, alertDate])
  @@map("ai_alert_daily_usage")
}

model AIFindingAlertDelivery {
  id             String   @id @db.Char(24)
  companyId      String   @map("company_id") @db.Char(24)
  userId         String   @map("user_id") @db.Char(24)
  findingId      String   @map("finding_id")
  alertDate      DateTime @map("alert_date") @db.Date
  notificationId String?  @map("notification_id") @db.Char(24)
  suppressed     Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([companyId, userId, findingId, alertDate])
  @@index([companyId, userId, alertDate])
  @@map("ai_finding_alert_deliveries")
}

model AIActionProposal {
  id                      String    @id @db.Char(24)
  proposalId              String    @map("proposal_id")
  company                 String    @db.Char(24)
  createdBy               String    @map("created_by") @db.Char(24)
  type                    String
  status                  String    @default("draft")
  payload                 Json      @default("{}")
  evidenceFactIds         String[]  @default([]) @map("evidence_fact_ids")
  sourceRecommendationIds String[]  @default([]) @map("source_recommendation_ids")
  sourceFindingIds        String[]  @default([]) @map("source_finding_ids")
  riskLevel               String    @map("risk_level")
  approvalRequiredByRole  String[]  @default([]) @map("approval_required_by_role")
  approvedBy              String?   @map("approved_by") @db.Char(24)
  approvedAt              DateTime? @map("approved_at") @db.Timestamptz(3)
  rejectedBy              String?   @map("rejected_by") @db.Char(24)
  rejectedAt              DateTime? @map("rejected_at") @db.Timestamptz(3)
  rejectionReason         String?   @map("rejection_reason")
  executedBy              String?   @map("executed_by") @db.Char(24)
  executedAt              DateTime? @map("executed_at") @db.Timestamptz(3)
  executionResult         Json?     @map("execution_result")
  metadata                Json      @default("{}")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([company, proposalId])
  @@index([company, status, updatedAt])
  @@index([company, type, status])
  @@map("ai_action_proposals")
}

model ImportTemplate {
  id            String    @id @db.Char(24)
  companyId     String    @map("company_id") @db.Char(24)
  entityType    String    @map("entity_type")
  name          String
  columnMapping Json      @default("{}") @map("column_mapping")
  createdBy     String    @map("created_by") @db.Char(24)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(3)
  useCount      Int       @default(0) @map("use_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, entityType, name])
  @@index([companyId, entityType])
  @@map("import_templates")
}

model ImportLog {
  id               String    @id @db.Char(24)
  companyId        String    @map("company_id") @db.Char(24)
  entityType       String    @map("entity_type")
  importedBy       String    @map("imported_by") @db.Char(24)
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)
  status           String    @default("pending")
  totalRows        Int       @default(0) @map("total_rows")
  successRows      Int       @default(0) @map("success_rows")
  errorRows        Int       @default(0) @map("error_rows")
  skippedRows      Int       @default(0) @map("skipped_rows")
  templateUsed     String?   @map("template_used") @db.Char(24)
  errorReportUrl   String?   @map("error_report_url")
  resultsReportUrl String?   @map("results_report_url")
  fileName         String    @map("file_name")
  jobId            String?   @map("job_id")
  rowOutcomes      Json      @default("[]") @map("row_outcomes")
  errorMessage     String?   @map("error_message")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, entityType, startedAt])
  @@index([jobId])
  @@map("import_logs")
}

model SystemSettings {
  id                                 String   @id @db.Char(24)
  companyId                          String   @unique @map("company_id") @db.Char(24)
  invoicePrefix                      String   @default("INV") @map("invoice_prefix")
  invoiceFooterText                  String?  @map("invoice_footer_text")
  invoicePaymentInstructions         String?  @map("invoice_payment_instructions")
  defaultInvoiceDueDays              Int      @default(30) @map("default_invoice_due_days")
  defaultQuoteExpiryDays             Int      @default(30) @map("default_quote_expiry_days")
  autoApplyVat                       Boolean  @default(false) @map("auto_apply_vat")
  defaultVatRateId                   String?  @map("default_vat_rate_id") @db.Char(24)
  defaultCostingMethod               String   @default("fifo") @map("default_costing_method")
  laborCostingBasis                  String   @default("gross_salary") @map("labor_costing_basis")
  laborStandardHoursPerWeek          Decimal  @default(40) @map("labor_standard_hours_per_week") @db.Decimal(7, 2)
  laborCostRoleRates                 Json     @default("{}") @map("labor_cost_role_rates")
  allowNegativeStock                 Boolean  @default(false) @map("allow_negative_stock")
  lowStockAlertEnabled               Boolean  @default(true) @map("low_stock_alert_enabled")
  autoReorderEnabled                 Boolean  @default(true) @map("auto_reorder_enabled")
  autoReorderCreateDocuments         Boolean  @default(true) @map("auto_reorder_create_documents")
  autoReorderSafetyStockDays         Int      @default(7) @map("auto_reorder_safety_stock_days")
  autoReorderSalesLookbackDays       Int      @default(90) @map("auto_reorder_sales_lookback_days")
  autoReorderDirectPurchaseThreshold Float    @default(0) @map("auto_reorder_direct_purchase_threshold")
  autoReorderCreatedBy               String?  @map("auto_reorder_created_by") @db.Char(24)
  requirePoApproval                  Boolean  @default(true) @map("require_po_approval")
  poApprovalThreshold                Float    @default(0) @map("po_approval_threshold")
  requireInvoiceApproval             Boolean  @default(false) @map("require_invoice_approval")
  documentTermsAndConditions         String?  @map("document_terms_and_conditions")
  documentThemeColor                 String   @default("#1D9E75") @map("document_theme_color")
  notifyOnLowStock                   Boolean  @default(true) @map("notify_on_low_stock")
  notifyOnOverdueInvoice             Boolean  @default(true) @map("notify_on_overdue_invoice")
  overdueInvoiceAlertDays            Int      @default(7) @map("overdue_invoice_alert_days")
  posOfflineEnabled                  Boolean  @default(false) @map("pos_offline_enabled")
  posOfflineMaxHours                 Int      @default(24) @map("pos_offline_max_hours")
  posOfflineQueueLimit               Float    @default(1000000) @map("pos_offline_queue_limit")
  posNegativeStockEscalationDays     Int      @default(3) @map("pos_negative_stock_escalation_days")
  lastUpdatedBy                      String?  @map("last_updated_by") @db.Char(24)
  createdAt                          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

model LaborCostingPolicy {
  id                  String   @id @db.Char(24)
  companyId           String   @map("company_id") @db.Char(24)
  effectiveFrom       DateTime @map("effective_from") @db.Date
  basis               String
  standardWeeklyHours Decimal  @map("standard_weekly_hours") @db.Decimal(7, 2)
  roleRates           Json     @default("{}") @map("role_rates")
  actorUserId         String?  @map("actor_user_id") @db.Char(24)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, effectiveFrom(sort: Desc), createdAt(sort: Desc)])
  @@map("labor_costing_policies")
}

model WarehouseInventoryCost {
  id          String   @id @db.Char(24)
  companyId   String   @map("company_id") @db.Char(24)
  warehouseId String   @map("warehouse_id") @db.Char(24)
  productId   String   @map("product_id") @db.Char(24)
  totalQty    Decimal  @default(0) @map("total_qty") @db.Decimal(19, 6)
  totalValue  Decimal  @default(0) @map("total_value") @db.Decimal(19, 4)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, warehouseId, productId])
  @@index([companyId, warehouseId])
  @@index([companyId, productId])
  @@map("warehouse_inventory_costs")
}

model FixedDeposit {
  id                       String   @id @db.Char(24)
  companyId                String   @map("company_id") @db.Char(24)
  bankAccountId            String?  @map("bank_account_id") @db.Char(24)
  depositReference         String   @map("deposit_reference")
  bankName                 String   @map("bank_name")
  principalAmount          Decimal  @map("principal_amount") @db.Decimal(19, 4)
  interestRate             Float    @map("interest_rate")
  startDate                DateTime @map("start_date") @db.Timestamptz(3)
  maturityDate             DateTime @map("maturity_date") @db.Timestamptz(3)
  interestPaymentFrequency String   @default("at_maturity") @map("interest_payment_frequency")
  linkedAssetAccount       String   @default("1105") @map("linked_asset_account")
  linkedIncomeAccount      String   @default("4300") @map("linked_income_account")
  linkedAccrualAccount     String   @default("1350") @map("linked_accrual_account")
  autoRollover             Boolean  @default(false) @map("auto_rollover")
  status                   String   @default("active")
  totalInterestAccrued     Decimal  @default(0) @map("total_interest_accrued") @db.Decimal(19, 4)
  totalInterestReceived    Decimal  @default(0) @map("total_interest_received") @db.Decimal(19, 4)
  notes                    String?
  createdBy                String?  @map("created_by") @db.Char(24)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, status])
  @@index([companyId, maturityDate])
  @@map("fixed_deposits")
}

model PrecomputedAggregation {
  id                String   @id @db.Char(24)
  company           String   @db.Char(24)
  type              String
  period            String
  asOfDate          DateTime @default(now()) @map("as_of_date") @db.Timestamptz(3)
  data              Json
  computedAt        DateTime @default(now()) @map("computed_at") @db.Timestamptz(3)
  computationTimeMs Int?     @map("computation_time_ms")
  status            String   @default("success")
  errorMessage      String?  @map("error_message")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([company, type, period])
  @@index([company, type, asOfDate])
  @@map("precomputed_aggregations")
}

model PaymentSchedule {
  id                   String    @id @db.Char(24)
  companyId            String    @map("company_id") @db.Char(24)
  purchaseId           String    @map("purchase_id") @db.Char(24)
  supplierId           String    @map("supplier_id") @db.Char(24)
  installmentNumber    Int       @map("installment_number")
  scheduledAmount      Decimal   @map("scheduled_amount") @db.Decimal(19, 4)
  scheduledDate        DateTime  @map("scheduled_date") @db.Timestamptz(3)
  status               String    @default("pending")
  paidAmount           Decimal   @default(0) @map("paid_amount") @db.Decimal(19, 4)
  paidDate             DateTime? @map("paid_date") @db.Timestamptz(3)
  paymentMethod        String?   @map("payment_method")
  paymentReference     String?   @map("payment_reference")
  paymentNotes         String?   @map("payment_notes")
  earlyPaymentDiscount Json      @default("{}") @map("early_payment_discount")
  notes                String?
  createdBy            String?   @map("created_by") @db.Char(24)
  updatedBy            String?   @map("updated_by") @db.Char(24)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, purchaseId])
  @@index([companyId, supplierId])
  @@index([companyId, scheduledDate])
  @@index([companyId, status])
  @@map("payment_schedules")
}

model Subscription {
  id                 String    @id @db.Char(24)
  companyId          String    @map("company_id") @db.Char(24)
  clientId           String    @map("client_id") @db.Char(24)
  recurringInvoiceId String?   @map("recurring_invoice_id") @db.Char(24)
  planName           String?
  amount             Decimal   @default(0) @db.Decimal(19, 4)
  currency           String    @default("FRW")
  billingCycle       String    @map("billing_cycle")
  interval           Int       @default(1)
  status             String    @default("active")
  startDate          DateTime  @default(now()) @map("start_date") @db.Timestamptz(3)
  endDate            DateTime? @map("end_date") @db.Timestamptz(3)
  nextBillingDate    DateTime? @map("next_billing_date") @db.Timestamptz(3)
  createdBy          String?   @map("created_by") @db.Char(24)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId])
  @@index([companyId, status])
  @@map("subscriptions")
}

model CashDrawer {
  id             String    @id @db.Char(24)
  companyId      String    @map("company_id") @db.Char(24)
  drawerId       String    @map("drawer_id")
  status         String    @default("closed")
  openedBy       String?   @map("opened_by") @db.Char(24)
  openedAt       DateTime? @map("opened_at") @db.Timestamptz(3)
  closedBy       String?   @map("closed_by") @db.Char(24)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(3)
  openingBalance Decimal   @default(0) @map("opening_balance") @db.Decimal(19, 4)
  closingBalance Decimal   @default(0) @map("closing_balance") @db.Decimal(19, 4)
  transactions   Json      @default("[]")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, drawerId])
  @@index([companyId, status])
  @@map("cash_drawers")
}

model PosHeldSale {
  id          String   @id @db.Char(24)
  companyId   String   @map("company_id") @db.Char(24)
  createdById String   @map("created_by_id") @db.Char(24)
  label       String
  saleData    Json     @map("sale_data")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("pos_held_sales")
}

/// Durable idempotency ledger for POS checkout requests. The unique composite
/// key prevents network retries from creating duplicate invoices or stock moves.
model PosSaleRequest {
  companyId   String   @map("company_id") @db.Char(24)
  requestKey  String   @map("request_key") @db.VarChar(100)
  createdById String   @map("created_by_id") @db.Char(24)
  payloadHash String   @map("payload_hash") @db.Char(64)
  invoiceId   String?  @map("invoice_id") @db.Char(24)
  status      String   @default("processing")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([companyId, requestKey])
  @@index([createdAt])
  @@map("pos_sale_requests")
}

/// Auditable manager-authorized re-key operations used to recover a distinct
/// saved checkout when its browser idempotency key belongs to another sale.
model PosSaleRequestRecovery {
  id                    String   @id @db.Char(24)
  companyId             String   @map("company_id") @db.Char(24)
  originalRequestKey    String   @map("original_request_key") @db.VarChar(100)
  replacementRequestKey String   @map("replacement_request_key") @db.VarChar(100)
