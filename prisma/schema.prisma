  originalInvoiceId     String   @map("original_invoice_id") @db.Char(24)
  initiatedById         String   @map("initiated_by_id") @db.Char(24)
  approvedById          String   @map("approved_by_id") @db.Char(24)
  reason                String
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([companyId, replacementRequestKey])
  @@index([companyId, originalRequestKey, createdAt])
  @@map("pos_sale_request_recoveries")
}

